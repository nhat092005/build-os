#!/bin/sh
# LED blink service

GPIO_BASE=512 # Base GPIO number for Raspberry Pi
LED_PIN=17  # GPIO pin number for the LED
BLINK_INTERVAL=1  # Blink interval in seconds
PIDFILE="/var/run/blink_led.pid"

start() {
    # Export GPIO pin and set as output
    echo "$((GPIO_BASE + LED_PIN))" > /sys/class/gpio/export 2>/dev/null
    echo "out" > /sys/class/gpio/gpio$((GPIO_BASE + LED_PIN))/direction

    # Start blinking in background
    (
        while true; do
            echo "1" > /sys/class/gpio/gpio$((GPIO_BASE + LED_PIN))/value
            sleep $BLINK_INTERVAL
            echo "0" > /sys/class/gpio/gpio$((GPIO_BASE + LED_PIN))/value
            sleep $BLINK_INTERVAL
        done
    ) &
    echo $! > "$PIDFILE"
    echo "LED blinking started"
}

end() {
    # Stop blinking and cleanup
    [ -f "$PIDFILE" ] && kill $(cat "$PIDFILE") 2>/dev/null && echo "LED blinking stopped"
    rm -f "$PIDFILE"
    echo "$((GPIO_BASE + LED_PIN))" > /sys/class/gpio/unexport 2>/dev/null
}

case "$1" in
    start) start ;;
    stop) end ;;
    *) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac