# ESP32 UART Driver Makefile
ESP32_UART_DRIVER_VERSION = 1.0.0
ESP32_UART_DRIVER_SITE = $(BR2_EXTERNAL_NHAT092005_PATH)/../drivers/esp32-uart
ESP32_UART_DRIVER_SITE_METHOD = local
ESP32_UART_DRIVER_LICENSE = GPL-2.0
ESP32_UART_DRIVER_LICENSE_FILES = LICENSE

define ESP32_UART_DRIVER_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) \
		CC=$(TARGET_CC) \
		CFLAGS="$(TARGET_CFLAGS)" \
		LDFLAGS="$(TARGET_LDFLAGS)" \
		TOPDIR=$(BR2_EXTERNAL_NHAT092005_PATH)/.. \
		all
endef

define ESP32_UART_DRIVER_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/build/tools/esp32-ctl \
		$(TARGET_DIR)/usr/bin/esp32-ctl
endef

$(eval $(generic-package))
