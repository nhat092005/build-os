# STM32 UART Driver Makefile
STM32_UART_DRIVER_VERSION = 1.0.0
STM32_UART_DRIVER_SITE = $(BR2_EXTERNAL_NHAT092005_PATH)/../drivers/stm32-uart
STM32_UART_DRIVER_SITE_METHOD = local
STM32_UART_DRIVER_LICENSE = GPL-2.0
STM32_UART_DRIVER_LICENSE_FILES = LICENSE

define STM32_UART_DRIVER_BUILD_CMDS
	$(TARGET_MAKE_ENV) $(MAKE) -C $(@D) \
		CC=$(TARGET_CC) \
		CFLAGS="$(TARGET_CFLAGS)" \
		LDFLAGS="$(TARGET_LDFLAGS)" \
		TOPDIR=$(BR2_EXTERNAL_NHAT092005_PATH)/.. \
		all
endef

define STM32_UART_DRIVER_INSTALL_TARGET_CMDS
	$(INSTALL) -D -m 0755 $(@D)/build/tools/stm32-ctl \
		$(TARGET_DIR)/usr/bin/stm32-ctl
endef

$(eval $(generic-package))
