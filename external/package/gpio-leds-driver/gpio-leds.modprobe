# LED GPIO Custom module parameters
# This file is for reference only - not installed by default
# To use, copy to /etc/modprobe.d/ and uncomment the option line

# Enable dynamic debug messages
#options gpio_leds dyndbg=+p

# Note: This driver is primarily configured via Device Tree overlay
# Example: dtoverlay=gpio-leds,gpio=27,label="status:red:led",trigger="heartbeat"
# 
# Manual module loading (without Device Tree):
#   Not recommended - use Device Tree overlay instead
#
# See documentation at: /usr/share/doc/leds-gpio-custom-driver/README.md
