# GPIO Character Device module parameters
# This file is for reference only - not installed by default
# To use, copy to /etc/modprobe.d/ and uncomment the option line

# Set default GPIO pin (default: 17)
#options gpio_chardev gpio_pin=17

# Usage:
#   1. Copy this file: cp gpio-chardev.modprobe /etc/modprobe.d/gpio-chardev.conf
#   2. Uncomment and edit the options line above
#   3. Reboot or: rmmod gpio_chardev && modprobe gpio_chardev
