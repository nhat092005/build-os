# Kernel config fragment for Rust support
# Applied via BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES

# Disable MODVERSIONS – incompatible with CONFIG_RUST in kernel 6.12+
# CONFIG_MODVERSIONS is not set

# Enable Rust support in the kernel
# Requires: rustc >= 1.78.0, bindgen >= 0.65.1, rust-src, libclang
CONFIG_RUST=y
